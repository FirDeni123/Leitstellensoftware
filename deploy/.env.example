# ILS-Sim Serverkonfiguration – Kopie als .env anlegen. NIEMALS ins Git einchecken.
# scripts/install-ubuntu.sh erzeugt diese Datei mit zufälligen Geheimnissen automatisch.

# DNS-Name oder IP, unter der die Clients den Server erreichen (für das TLS-Zertifikat)
ILS_SERVER_NAME=leitstelle-server.local
ILS_HTTPS_PORT=443

POSTGRES_PASSWORD=
# 48+ zufällige Zeichen:  docker compose run --rm api ils-admin generate-jwt-secret
ILS_JWT_SECRET=
# Fernet-Schlüssel (kommagetrennt, erster verschlüsselt):  ... ils-admin generate-key
ILS_ENCRYPTION_KEYS=

ILS_WORKERS=2
